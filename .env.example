# CloudPulse local prototype — copy to `.env` and adjust as needed:
#   cp .env.example .env

# -----------------------------------------------------------------------------
# App / environment
# -----------------------------------------------------------------------------
ENVIRONMENT=development
APP_URL=http://localhost:3000

# API Gateway (published on host port 8080)
HTTP_ADDR=:8080
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WEBSOCKET_URL=ws://localhost:8080/ws

# Internal gRPC service discovery (Docker network hostnames)
TRIP_SERVICE_URL=trip-service:9093
DRIVER_SERVICE_URL=driver-service:9092

# -----------------------------------------------------------------------------
# Messaging (used by all Go services today)
# -----------------------------------------------------------------------------
RABBITMQ_URI=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# -----------------------------------------------------------------------------
# Trip data store (used by trip-service today)
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB=ride-sharing

# -----------------------------------------------------------------------------
# Redis — real-time driver location tracking (api-gateway + driver-service)
# In AWS, point this at the Terraform ElastiCache endpoint (terraform output redis_url)
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# PostgreSQL — persistent driver registry (driver-service)
# In AWS, point this at the Terraform RDS endpoint (credentials in Secrets Manager)
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cloudpulse
POSTGRES_USER=cloudpulse
POSTGRES_PASSWORD=cloudpulse
DATABASE_URL=postgres://cloudpulse:cloudpulse@postgres:5432/cloudpulse?sslmode=disable

# -----------------------------------------------------------------------------
# Routing / payments / tracing
# -----------------------------------------------------------------------------
OSRM_API=https://router.project-osrm.org
JAEGER_ENDPOINT=http://jaeger:14268/api/traces

# Stripe — use real test keys from https://dashboard.stripe.com/test/apikeys
# for live Stripe Checkout. Prefer PhonePe (default); set PAYMENT_PROVIDER=stripe to force Stripe.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_KEY=whsec_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SUCCESS_URL=http://localhost:3000?payment=success
STRIPE_CANCEL_URL=http://localhost:3000?payment=cancel

# PhonePe — leave merchant credentials empty to use local mock checkout (pp_test_local_*).
PAYMENT_PROVIDER=phonepe
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=UAT
PHONEPE_CALLBACK_URL=http://localhost:8080/webhook/phonepe
PHONEPE_SUCCESS_URL=http://localhost:3000?payment=success
PHONEPE_CANCEL_URL=http://localhost:3000?payment=cancel

# Local prototype flags:
# For the real two-app flow (rider :3000 + driver :3001), keep these false.
# Set true only for single-tab demo without a live driver.
LOCAL_SEED_DRIVERS=false
LOCAL_AUTO_ACCEPT=false
LOCAL_SIMULATE_TRIPS=false
TRIP_OFFER_TIMEOUT_SEC=30
JWT_SECRET=cloudpulse-dev-jwt-secret-change-me
DRIVER_SERVICE_HTTP_URL=http://driver-service:8085
TRIP_SERVICE_HTTP_URL=http://trip-service:8086
